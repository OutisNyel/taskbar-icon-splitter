<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseSystemDrawing>true</UseSystemDrawing>
    <AssemblyName>TaskbarIconSplitter.Native</AssemblyName>
    <RootNamespace>TaskbarIconSplitter.Native</RootNamespace>
    <ApplicationIcon>..\..\assets\taskbar-icon-splitter.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarIconSplitter.Native.Tests" />
  </ItemGroup>
</Project>
