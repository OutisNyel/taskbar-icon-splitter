{
  "manifest_version": 3,
  "name": "Taskbar Icon Splitter",
  "description": "按网站域名自动整理 Edge 标签页，并为每个网站窗口显示独立的 Windows 任务栏图标。",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Taskbar Icon Splitter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
